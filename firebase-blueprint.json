{
  "entities": {
    "Employee": {
      "title": "Employee",
      "description": "Registered employee profile at PTPN Kebun Kertamanah",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 150
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "nip": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-zA-Z0-9.\\-]+$"
        },
        "division": {
          "type": "string",
          "enum": [
            "Tata Usaha & SDM",
            "Tanaman & Lapangan",
            "Teknik & Pengolahan",
            "Keuangan & Akuntansi",
            "Keamanan",
            "Umum & Aset"
          ],
          "maxLength": 60
        },
        "position": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "enum": ["employee", "admin"],
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "fullName",
        "nip",
        "division",
        "position",
        "role",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Explicit HRD admin role marker document",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 150
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time"
        },
        "grantedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": ["uid", "email", "grantedAt", "grantedBy"]
    },
    "OfficeSettings": {
      "title": "OfficeSettings",
      "description": "PTPN Kertamanah office geofence and work schedule configuration",
      "type": "object",
      "properties": {
        "officeName": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "address": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "radiusMeters": {
          "type": "number"
        },
        "workStartTime": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "maxLength": 5
        },
        "workEndTime": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "maxLength": 5
        },
        "lateToleranceMinutes": {
          "type": "number"
        },
        "strictGeofence": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "officeName",
        "address",
        "latitude",
        "longitude",
        "radiusMeters",
        "workStartTime",
        "workEndTime",
        "lateToleranceMinutes",
        "strictGeofence",
        "updatedAt",
        "updatedBy"
      ]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Daily check-in and check-out record for an employee at PTPN Kertamanah",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "employeeName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "employeeNip": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30
        },
        "division": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "dateKey": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "checkInTime": {
          "type": "string",
          "format": "date-time"
        },
        "checkInLat": {
          "type": "number"
        },
        "checkInLng": {
          "type": "number"
        },
        "checkInDistanceMeters": {
          "type": "number"
        },
        "checkInPhoto": {
          "type": "string",
          "maxLength": 80000
        },
        "checkInLocationType": {
          "type": "string",
          "enum": ["office", "field_duty"],
          "maxLength": 20
        },
        "checkInNote": {
          "type": "string",
          "maxLength": 300
        },
        "status": {
          "type": "string",
          "enum": ["on_time", "late", "field_duty"],
          "maxLength": 20
        },
        "checkOutTime": {
          "type": "string",
          "format": "date-time"
        },
        "checkOutLat": {
          "type": "number"
        },
        "checkOutLng": {
          "type": "number"
        },
        "checkOutDistanceMeters": {
          "type": "number"
        },
        "checkOutPhoto": {
          "type": "string",
          "maxLength": 80000
        },
        "checkOutNote": {
          "type": "string",
          "maxLength": 300
        },
        "workDurationMinutes": {
          "type": "number"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "employeeName",
        "employeeNip",
        "division",
        "dateKey",
        "checkInTime",
        "checkInLat",
        "checkInLng",
        "checkInDistanceMeters",
        "checkInPhoto",
        "checkInLocationType",
        "checkInNote",
        "status",
        "updatedAt"
      ]
    },
    "LeaveRequest": {
      "title": "LeaveRequest",
      "description": "Employee leave, sick, or field duty permit request",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "employeeName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "employeeNip": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30
        },
        "division": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "type": {
          "type": "string",
          "enum": ["izin", "sakit", "cuti", "dinas_luar"],
          "maxLength": 20
        },
        "startDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "endDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "maxLength": 10
        },
        "reason": {
          "type": "string",
          "minLength": 5,
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "maxLength": 20
        },
        "reviewerUid": {
          "type": "string",
          "maxLength": 128
        },
        "reviewerNote": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "employeeName",
        "employeeNip",
        "division",
        "type",
        "startDate",
        "endDate",
        "reason",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/employees/{uid}": {
      "schema": { "$ref": "#/entities/Employee" },
      "description": "Employee profile and PII isolated to owner and HRD admin"
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Explicit HRD admin markers"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/OfficeSettings" },
      "description": "Global office geofence and work-hour configuration (settingId = office)"
    },
    "/attendance/{recordId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Daily employee clock-in and clock-out records (recordId = {uid}_{YYYY-MM-DD})"
    },
    "/leaveRequests/{requestId}": {
      "schema": { "$ref": "#/entities/LeaveRequest" },
      "description": "Employee leave, sick, and field-duty permit requests"
    }
  }
}
